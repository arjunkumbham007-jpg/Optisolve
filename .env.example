# Replace these example values before running Docker Compose.
# DOMAIN must be a domain you own and have pointed to your server.
DOMAIN=optisolve.example.com
OPTISOLVE_BASE_URL=https://optisolve.example.com
OPTISOLVE_ENV=production
OPTISOLVE_JOB_TTL_HOURS=24
OPTISOLVE_MAX_STORED_JOBS=100
OPTISOLVE_SOLVE_LIMIT_PER_MINUTE=5
